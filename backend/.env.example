GEMINI_API_KEY=your_gemini_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
PORT=8000
DEBUG=True

# Optional: Gemini model ID used for poster fallback, supplemental OSTs, and YouTube fallback
GEMINI_MODEL=gemini-3.8-flash

# Optional: Tier 2 trace.moe anime frame lookup
TRACE_MOE_ENABLED=true
TRACE_MOE_THRESHOLD=0.88
# Leave blank to use the free anonymous tier (~1,000 searches/month per IP)
TRACE_MOE_API_KEY=

# Optional: Live FAISS write-through for high-confidence fallback matches
AUTO_INGEST_HIGH_CONFIDENCE=true

# Optional for production:
# ALLOW_ORIGINS=https://yourdomain.com
